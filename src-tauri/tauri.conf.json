{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuse",
  "version": "0.1.0",
  "identifier": "com.fuse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fuse",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Visual command workflow builder",
    "longDescription": "Fuse turns repetitive terminal commands into visual workflows you run with one button.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/VladB-evs/Fuse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5ODVEQ0U5MDc0NzE0RTQKUldUa0ZFY0g2ZHlGZVJ3NnlTUXhhbFRHQVpaTXVIMjRVREhCR0Q4cWFWUTVtYUdXRXY4SUE4NlgK"
    }
  }
}
